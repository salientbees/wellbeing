{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "services/**/*.ts", "contracts/**/*.ts"]
}
