{
  "name": "wellbeing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "contracts:generate": "node contracts/generate.ts",
    "contracts:check": "node contracts/generate.ts --check",
    "test": "node --test packages/backend-domain/test/*.test.ts services/api/test/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-wellbeing --only firestore,storage \"node --test firebase/test/*.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "openai": "7.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.3",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.1",
    "typescript": "7.0.2"
  }
}
