{
  "openapi": "3.1.0",
  "info": {
    "title": "Wellbeing API",
    "version": "0.1.0",
    "description": "Runtime common and account-preference schemas. Other business routes remain specified in docs/API_SPECIFICATION.md. No production API is deployed."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "paths": {
    "/me/profile": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed revision, committedSeq and current account"
          },
          "409": {
            "description": "Revision or idempotency conflict; refresh and review before resubmission"
          },
          "422": {
            "description": "Invalid fields or memory grant without AI consent"
          }
        }
      }
    },
    "/me/settings": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed revision, committedSeq and current account"
          },
          "409": {
            "description": "Revision or idempotency conflict; refresh and review before resubmission"
          },
          "422": {
            "description": "Invalid fields or memory grant without AI consent"
          }
        }
      }
    },
    "/me/consents": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed revision, committedSeq and current account"
          },
          "409": {
            "description": "Revision or idempotency conflict; refresh and review before resubmission"
          },
          "422": {
            "description": "Invalid fields or memory grant without AI consent"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "appCheck": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Firebase-AppCheck"
      }
    },
    "schemas": {
      "ProfilePatch": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationCreatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "changes": {
            "type": "object",
            "properties": {
              "preferredName": {
                "type": "string",
                "maxLength": 80
              },
              "locale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "timeZone": {
                "type": "string",
                "maxLength": 80
              },
              "unitPreferences": {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "string",
                    "enum": [
                      "kg",
                      "lb"
                    ]
                  },
                  "length": {
                    "type": "string",
                    "enum": [
                      "cm",
                      "in"
                    ]
                  },
                  "volume": {
                    "type": "string",
                    "enum": [
                      "ml",
                      "flOz"
                    ]
                  }
                },
                "required": [
                  "weight",
                  "length",
                  "volume"
                ],
                "additionalProperties": false
              },
              "coachingTone": {
                "type": "string",
                "enum": [
                  "gentle",
                  "direct",
                  "encouraging"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "operationCreatedAt",
          "baseRevision",
          "operationId",
          "changes"
        ],
        "additionalProperties": false
      },
      "SettingsPatch": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationCreatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "changes": {
            "type": "object",
            "properties": {
              "theme": {
                "type": "string",
                "enum": [
                  "system",
                  "light",
                  "dark"
                ]
              },
              "reduceMotion": {
                "type": "boolean"
              },
              "hiddenMetrics": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "weight",
                    "nutrition",
                    "measurements"
                  ]
                }
              },
              "weekStartsOn": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "notificationPreferences": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "quietStart": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "quietEnd": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "enabled",
                  "quietStart",
                  "quietEnd"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "operationCreatedAt",
          "baseRevision",
          "operationId",
          "changes"
        ],
        "additionalProperties": false
      },
      "ConsentChange": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationCreatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "category": {
            "type": "string",
            "enum": [
              "aiProcessing",
              "memory",
              "analytics",
              "crashReports",
              "healthImport"
            ]
          },
          "granted": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "operationCreatedAt",
          "baseRevision",
          "operationId",
          "category",
          "granted",
          "policyVersion"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z_]{0,63}$"
              },
              "message": {
                "type": "string",
                "maxLength": 256
              },
              "requestId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "retryable": {
                "type": "boolean"
              },
              "fieldErrors": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "code": {
                      "type": "string",
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "field",
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ResponseMeta": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "nextCursor": {
            "type": "string",
            "maxLength": 2048
          },
          "sourceThroughSeq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dataEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "requestId",
          "serverTime"
        ],
        "additionalProperties": false
      },
      "MutationMetadata": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationCreatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "operationCreatedAt",
          "baseRevision"
        ],
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "firebaseIdToken": [],
      "appCheck": []
    }
  ]
}
